                <mxCell id="s3_tier_gfr_icon" value="" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3_glacier_flexible_retrieval;fillColor=#1A5276;strokeColor=#ffffff;pointerEvents=1;" parent="1" vertex="1">
                    <mxGeometry x="965" y="1145" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="s3_tier_da" value="S3 Glacier&#10;Deep Archive&#10;&#10;- Latency: 12-48 giờ&#10;- Min 180 ngày lưu trữ&#10;- Rẻ nhất&#10;- $0.00099/GB" style="rounded=1;arcSize=10;strokeColor=#17202A;strokeWidth=2;fillColor=#D5D8DC;verticalAlign=top;align=center;spacingTop=10;fontColor=#17202a;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1130" y="1130" width="185" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s3_tier_da_icon" value="" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3_glacier_deep_archive;fillColor=#17202A;strokeColor=#ffffff;pointerEvents=1;" parent="1" vertex="1">
                    <mxGeometry x="1195" y="1145" width="50" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_std_ia" value="Lifecycle rule&#10;≥ 30 ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FF9900;strokeWidth=2;endArrow=block;endFill=1;fontColor=#e67e22;fontSize=10;fontStyle=1;" parent="1" source="s3_tier_standard" target="s3_tier_ia" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_ia_gir" value="Lifecycle rule&#10;≥ 90 ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3498DB;strokeWidth=2;endArrow=block;endFill=1;fontColor=#2980b9;fontSize=10;fontStyle=1;" parent="1" source="s3_tier_ia" target="s3_tier_gir" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_gir_gfr" value="Lifecycle rule&#10;≥ 90 ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1A5276;strokeWidth=2;endArrow=block;endFill=1;fontColor=#1a5276;fontSize=10;fontStyle=1;" parent="1" source="s3_tier_gir" target="s3_tier_gfr" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_gfr_da" value="Lifecycle rule&#10;≥ 180 ngày" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#17202A;strokeWidth=2;endArrow=block;endFill=1;fontColor=#17202a;fontSize=10;fontStyle=1;" parent="1" source="s3_tier_gfr" target="s3_tier_da" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="s3_tier_intelligent" value="S3 Intelligent-Tiering&#10;(Auto-tier, no retrieval fee)&#10;&#10;- Tự động chuyển tier theo access pattern&#10;- Monitoring fee: $0.0025/1000 objects&#10;- Không mất phí retrieval&#10;- Phù hợp: unpredictable access&#10;- Tối đa 4 tiers: Frequent / Infrequent&#10;  / Archive Instant / Deep Archive" style="rounded=1;arcSize=10;strokeColor=#8E44AD;strokeWidth=2;fillColor=#F4ECF7;verticalAlign=top;align=center;spacingTop=10;fontColor=#6c3483;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1320" width="380" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_features_box" value="S3 Key Features" style="rounded=1;arcSize=10;strokeColor=#3F8624;strokeWidth=2;fillColor=#F0FFF0;verticalAlign=top;align=center;spacingTop=10;fontColor=#2d6a4f;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1320" width="420" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_replication_box" value="S3 Replication" style="rounded=1;arcSize=10;strokeColor=#0073BB;strokeWidth=2;fillColor=#EBF5FB;verticalAlign=top;align=center;spacingTop=10;fontColor=#0073BB;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1110" y="1320" width="440" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_replication_text" value="🔄 Cross-Region Replication (CRR)&#10;   Source → Replica bucket (khác region)&#10;   Mục đích: DR, low-latency global access&#10;&#10;🔄 Same-Region Replication (SRR)&#10;   Mục đích: Log aggregation, test/prod sync&#10;   Yêu cầu: Versioning phải bật trên cả 2 bucket" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="1115" y="1345" width="430" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="s3_event_box" value="S3 Event Notifications" style="rounded=1;arcSize=10;strokeColor=#E05243;strokeWidth=2;fillColor=#FFF5F5;verticalAlign=top;align=center;spacingTop=10;fontColor=#c0392b;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1520" width="550" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_event_text" value="📣 Object uploaded/deleted → Trigger:&#10;&#10;  ├─ SNS Topic (fan-out notifications)&#10;  ├─ SQS Queue (decoupled processing)&#10;  ├─ Lambda Function (serverless processing)&#10;  └─ EventBridge (advanced routing, filtering)&#10;&#10;Dùng cho: image resize, data pipeline, audit log" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="215" y="1543" width="540" height="133" as="geometry"/>
                </mxCell>
                <mxCell id="s3_access_box" value="S3 Access Patterns" style="rounded=1;arcSize=10;strokeColor=#F58536;strokeWidth=2;fillColor=#FFF8F0;verticalAlign=top;align=center;spacingTop=10;fontColor=#d35400;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="810" y="1520" width="740" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s3_access_text" value="🌐 Static Website Hosting: index.html + error.html — serve trực tiếp từ S3&#10;🔒 Pre-Signed URL: chia sẻ object private có thời hạn (vd: 1 giờ)&#10;⚡ S3 Transfer Acceleration: dùng CloudFront edge → S3 (upload nhanh hơn)&#10;📦 Multipart Upload: bắt buộc file &gt; 5GB, khuyến nghị file &gt; 100MB&#10;🔍 S3 Select / Glacier Select: query CSV/JSON/Parquet trực tiếp trong S3 (tránh download toàn bộ)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=5;" parent="1" vertex="1">
                    <mxGeometry x="815" y="1543" width="730" height="133" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_delete" value="Lifecycle rule: Expire &amp; Delete&#10;(vd: xóa object sau 365 ngày)" style="rounded=1;arcSize=10;strokeColor=#E74C3C;strokeWidth=1.5;fillColor=#FADBD8;verticalAlign=middle;align=center;fontColor=#c0392b;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1360" y="1185" width="185" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="s3_lc_da_del" value="Expire" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E74C3C;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontColor=#c0392b;fontSize=10;" parent="1" source="s3_tier_da" target="s3_lc_delete" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
