                            <mxPoint x="302" y="1000"/>
                            <mxPoint x="302" y="1130"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3_crr_arrow" value="CRR&#10;(Cross-Region)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0073BB;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontColor=#0073BB;fontSize=10;fontStyle=1;" parent="1" source="s3_tier_standard" target="s3_replication_box" edge="1">
