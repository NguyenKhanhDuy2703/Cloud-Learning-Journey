        <mxCell id="e19" value="auth via IAM user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#545B64;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#545B64;fontStyle=1;" edge="1" parent="1" source="n_fleeting" target="n_iam">
