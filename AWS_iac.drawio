          <mxGeometry x="50" y="970" w="380" h="290" as="geometry"/>
        </mxCell>
        <mxCell id="legend_text" value="&lt;b&gt;① Developer pushes code → GitHub Actions&lt;/b&gt;&lt;br/&gt;→ builds CI Docker image → pushes to GHCR&lt;br/&gt;&lt;br/&gt;&lt;b&gt;② DevOps bootstraps infrastructure:&lt;/b&gt;&lt;br/&gt;• &lt;font color=&quot;#5C4EE5&quot;&gt;Packer&lt;/font&gt;: builds custom AMI (Amazon Linux 2023 + Docker + CI image)&lt;br/&gt;• &lt;font color=&quot;#5C4EE5&quot;&gt;Terraform&lt;/font&gt;: provisions ASG, Launch Template, IAM, SG&lt;br/&gt;&lt;br/&gt;&lt;b&gt;③ Runner Manager registers with GitLab&lt;/b&gt; (1 EC2, Docker Compose)&lt;br/&gt;&lt;b&gt;④ GitLab dispatches job&lt;/b&gt; → Runner Manager receives&lt;br/&gt;&lt;b&gt;⑤ fleeting-plugin-aws&lt;/b&gt; calls ASG: SetDesiredCapacity +1&lt;br/&gt;&lt;b&gt;⑥ Worker EC2 boots&lt;/b&gt; from custom AMI, Runner SSHes in, runs CI container&lt;br/&gt;&lt;b&gt;⑦ Job finishes&lt;/b&gt; → artifacts/logs reported to GitLab&lt;br/&gt;&lt;b&gt;⑧ Idle worker terminated&lt;/b&gt; → ASG scales back to 0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="55" y="990" w="370" h="265" as="geometry"/>
        </mxCell>
